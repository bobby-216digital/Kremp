{%- liquid
  assign color_scheme = section.settings.color_scheme
  assign faq_items = shop.metaobjects.collection_faq_item.values | sort: 'sort_order'
  assign max_items = 10
  assign schema_entity_count = 0
  assign include_schema = section.settings.include_structured_data
  assign context_collection_ids = '|'
  if collection != blank
    assign context_collection_ids = context_collection_ids | append: collection.id | append: '|'
  endif
  if product != blank and product.collections != blank
    for product_collection in product.collections
      assign col_id_token = '|' | append: product_collection.id | append: '|'
      unless context_collection_ids contains col_id_token
        assign context_collection_ids = context_collection_ids | append: product_collection.id | append: '|'
      endunless
    endfor
  endif
  assign has_items = false
  assign faq_page_name = section.settings.heading | default: 'Frequently Asked Questions'
-%}

{%- comment -%}
  Resolve an FAQ item's collection match.
  Handles both field naming conventions:
    - faq_item.collections.value  (list.collection_reference, handle = "collections")
    - faq_item.collection.value   (collection_reference, handle = "collection")
  Sets is_collection_specific = true when the item's collection matches the page context.
  Sets is_general = true when the item has no collection reference at all.
{%- endcomment -%}

{%- unless section.settings.randomize_by_collection -%}
{%- capture faq_schema_entities -%}
  {%- if context_collection_ids != '|' and faq_items != blank -%}
    {%- assign schema_displayed_count = 0 -%}
    {%- for faq_item in faq_items -%}
      {%- assign is_collection_specific = false -%}
      {%- assign is_general = false -%}
      {%- assign item_col_list = faq_item.collections.value -%}
      {%- assign item_col_single = faq_item.collection.value -%}
      {%- if item_col_list != blank -%}
        {%- for item_col in item_col_list -%}
          {%- assign col_token = '|' | append: item_col.id | append: '|' -%}
          {%- if context_collection_ids contains col_token -%}
            {%- assign is_collection_specific = true -%}
            {%- break -%}
          {%- endif -%}
        {%- endfor -%}
      {%- elsif item_col_single != blank -%}
        {%- assign col_token = '|' | append: item_col_single.id | append: '|' -%}
        {%- if context_collection_ids contains col_token -%}
          {%- assign is_collection_specific = true -%}
        {%- endif -%}
      {%- else -%}
        {%- assign is_general = true -%}
      {%- endif -%}

      {%- if is_collection_specific or is_general -%}
        {%- if faq_item.question.value != blank and faq_item.richtext_answer != blank -%}
          {%- unless schema_entity_count == 0 -%},{%- endunless -%}
          {
            "@type": "Question",
            "name": {{ faq_item.question.value | json }},
            "acceptedAnswer": {
              "@type": "Answer",
              "text": {{ faq_item.richtext_answer | metafield_tag | strip_html | strip | json }}
            }
          }
          {%- assign schema_entity_count = schema_entity_count | plus: 1 -%}
          {%- assign schema_displayed_count = schema_displayed_count | plus: 1 -%}
          {%- if schema_displayed_count >= max_items -%}{%- break -%}{%- endif -%}
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}
{%- endcapture -%}
{%- endunless -%}

{%- capture faq_markup -%}
  {%- if context_collection_ids != '|' and faq_items != blank -%}
    {%- assign collection_shown = 0 -%}
    {%- assign general_shown = 0 -%}
    <div id="faq-randomized-list-{{ section.id }}">

      {%- comment -%}--- Pass 1: collection-specific items, always shown first ---{%- endcomment -%}
      {%- for faq_item in faq_items -%}
        {%- assign is_collection_specific = false -%}
        {%- assign matched_col_id = '' -%}
        {%- assign item_col_list = faq_item.collections.value -%}
        {%- assign item_col_single = faq_item.collection.value -%}
        {%- if item_col_list != blank -%}
          {%- for item_col in item_col_list -%}
            {%- assign col_token = '|' | append: item_col.id | append: '|' -%}
            {%- if context_collection_ids contains col_token -%}
              {%- assign is_collection_specific = true -%}
              {%- assign matched_col_id = item_col.id -%}
              {%- break -%}
            {%- endif -%}
          {%- endfor -%}
        {%- elsif item_col_single != blank -%}
          {%- assign col_token = '|' | append: item_col_single.id | append: '|' -%}
          {%- if context_collection_ids contains col_token -%}
            {%- assign is_collection_specific = true -%}
            {%- assign matched_col_id = item_col_single.id -%}
          {%- endif -%}
        {%- endif -%}
        {%- if is_collection_specific and faq_item.question.value != blank and faq_item.richtext_answer != blank -%}
          {%- unless section.settings.randomize_by_collection -%}
            {%- if collection_shown >= max_items -%}{%- break -%}{%- endif -%}
          {%- endunless -%}
          {%- assign has_items = true -%}
          {%- assign collection_shown = collection_shown | plus: 1 -%}
          <details-disclosure data-faq-collection="{{ matched_col_id }}">
            <details class="disclosure disclosure--row">
              <summary>
                <div class="flex justify-between items-center">
                  <h3 class="disclosure__title disclosure__title--small xs:regular-text h6 font-body flex flex-auto items-center mb-0 text-current">
                    {{- faq_item.question.value -}}
                  </h3>
                  <span class="disclosure__toggle">
                    <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true" focusable="false" role="presentation" class="icon"><path d="M20 8.5 12.5 16 5 8.5" stroke="currentColor" stroke-width="1.5" fill="none"></path></svg>
                  </span>
                </div>
              </summary>
              <div class="disclosure__panel has-motion">
                <div class="disclosure__content rte">
                  {{ faq_item.richtext_answer | metafield_tag }}
                </div>
              </div>
            </details>
          </details-disclosure>
        {%- endif -%}
      {%- endfor -%}

      <span data-faq-divider hidden></span>

      {%- comment -%}--- Pass 2: general items (no collection assigned) ---{%- endcomment -%}
      {%- assign general_limit = max_items | minus: collection_shown -%}
      {%- for faq_item in faq_items -%}
        {%- assign item_col_list = faq_item.collections.value -%}
        {%- assign item_col_single = faq_item.collection.value -%}
        {%- assign is_general = false -%}
        {%- if item_col_list == blank and item_col_single == blank -%}
          {%- assign is_general = true -%}
        {%- endif -%}
        {%- if is_general and faq_item.question.value != blank and faq_item.richtext_answer != blank -%}
          {%- unless section.settings.randomize_by_collection -%}
            {%- if general_shown >= general_limit -%}{%- break -%}{%- endif -%}
          {%- endunless -%}
          {%- assign has_items = true -%}
          {%- assign general_shown = general_shown | plus: 1 -%}
          <details-disclosure>
            <details class="disclosure disclosure--row">
              <summary>
                <div class="flex justify-between items-center">
                  <h3 class="disclosure__title disclosure__title--small xs:regular-text h6 font-body flex flex-auto items-center mb-0 text-current">
                    {{- faq_item.question.value -}}
                  </h3>
                  <span class="disclosure__toggle">
                    <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true" focusable="false" role="presentation" class="icon"><path d="M20 8.5 12.5 16 5 8.5" stroke="currentColor" stroke-width="1.5" fill="none"></path></svg>
                  </span>
                </div>
              </summary>
              <div class="disclosure__panel has-motion">
                <div class="disclosure__content rte">
                  {{ faq_item.richtext_answer | metafield_tag }}
                </div>
              </div>
            </details>
          </details-disclosure>
        {%- endif -%}
      {%- endfor -%}

    </div>
  {%- endif -%}
{%- endcapture -%}

{%- if has_items -%}
  {%- unless section.settings.full_width -%}
    <div class="container">
  {%- endunless -%}

  <div class="section section--padded color-scheme color-scheme--{{ color_scheme }}{% if section.settings.custom_class != blank %} {{ section.settings.custom_class }}{% endif %}" id="{{ section.id }}">
    <div class="container">
      <div class="reading-width cc-animate-init cc-animate-in" data-cc-animate="">
        {%- if section.settings.heading != blank -%}
          <h2 class="h4 section__heading mb-12 text-center">
            {{ section.settings.heading | escape }}
          </h2>
        {%- endif -%}
        {{ faq_markup }}
      </div>
    </div>
    {%- if section.settings.randomize_by_collection -%}
      <script>
        document.addEventListener('DOMContentLoaded', function () {
          const faqContainer = document.getElementById('faq-randomized-list-{{ section.id }}');
          if (!faqContainer) return;
          const maxItems = {{ max_items }};
          const includeSchema = {{ include_schema | json }};
          const scriptId = 'faq-structured-data-{{ section.id }}';
          const shuffle = (arr) => { for (let i = arr.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); [arr[i], arr[j]] = [arr[j], arr[i]]; } return arr; };
          const divider = faqContainer.querySelector('[data-faq-divider]');
          const allChildren = Array.from(faqContainer.children);
          const dividerIdx = divider ? allChildren.indexOf(divider) : allChildren.length;
          const generalItems = shuffle(allChildren.slice(dividerIdx + 1));
          const groups = {};
          allChildren.slice(0, dividerIdx).forEach((el) => {
            const key = el.dataset.faqCollection || '_';
            if (!groups[key]) groups[key] = [];
            groups[key].push(el);
          });
          const groupArrays = Object.values(groups).map((g) => shuffle(g));
          const interleavedCollection = [];
          const maxRounds = Math.max(0, ...groupArrays.map((g) => g.length));
          for (let r = 0; r < maxRounds; r++) {
            groupArrays.forEach((g) => { if (r < g.length) interleavedCollection.push(g[r]); });
          }
          const selected = [...interleavedCollection, ...generalItems].slice(0, maxItems);
          faqContainer.innerHTML = '';
          selected.forEach((item) => faqContainer.appendChild(item));
          if (!includeSchema) return;
          const mainEntity = Array.from(faqContainer.children)
            .map((item) => {
              const question = item.querySelector('.disclosure__title')?.textContent?.trim();
              const answer = item.querySelector('.disclosure__content')?.textContent?.trim();
              if (!question || !answer) return null;
              return {
                '@type': 'Question',
                name: question,
                acceptedAnswer: { '@type': 'Answer', text: answer },
              };
            })
            .filter(Boolean);
          if (!mainEntity.length) return;
          let scriptEl = document.getElementById(scriptId);
          if (!scriptEl) {
            scriptEl = document.createElement('script');
            scriptEl.type = 'application/ld+json';
            scriptEl.id = scriptId;
            document.head.appendChild(scriptEl);
          }
          scriptEl.textContent = JSON.stringify({
            '@context': 'https://schema.org',
            '@type': 'FAQPage',
            name: {{ faq_page_name | json }},
            mainEntity,
          });
        });
      </script>
    {%- endif -%}
  </div>

  {%- if include_schema and section.settings.randomize_by_collection == false and schema_entity_count > 0 -%}
    <script type="application/ld+json" id="faq-structured-data-{{ section.id }}">
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "name": {{ faq_page_name | json }},
        "mainEntity": [{{ faq_schema_entities }}]
      }
    </script>
  {%- endif -%}

  {%- unless section.settings.full_width -%}
    </div>
  {%- endunless -%}
{%- endif -%}

{% schema %}
{
  "name": "Collections FAQ",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently Asked Questions" },
    { "type": "select", "id": "color_scheme", "label": "Color scheme", "options": [{ "value": "1", "label": "1" }, { "value": "none", "label": "None" }], "default": "none" },
    { "type": "checkbox", "id": "randomize_by_collection", "label": "Randomize FAQ order by collection", "default": false },
    { "type": "checkbox", "id": "include_structured_data", "label": "Include FAQ structured data (Google)", "default": true },
    { "type": "checkbox", "id": "full_width", "label": "Full Width", "default": true },
    { "type": "text", "id": "custom_class", "label": "Custom CSS class" }
  ],
  "presets": [{ "name": "Collections FAQ" }]
}
{% endschema %}
