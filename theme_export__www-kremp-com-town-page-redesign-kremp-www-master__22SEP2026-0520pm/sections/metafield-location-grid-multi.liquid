{%- assign mf_ns = section.settings.metafield_namespace -%}
{%- assign mf_key = section.settings.metafield_key -%}

{%- if template.name == 'page' -%}
  {%- assign mf_value = page.metafields[mf_ns][mf_key] -%}
{%- elsif template.name == 'product' -%}
  {%- assign mf_value = product.metafields[mf_ns][mf_key] -%}
{%- elsif template.name == 'article' -%}
  {%- assign mf_value = article.metafields[mf_ns][mf_key] -%}
{%- elsif template.name == 'collection' -%}
  {%- assign mf_value = collection.metafields[mf_ns][mf_key] -%}
{%- endif -%}

{%- unless mf_value == blank -%}
  {%- assign rich_nodes = mf_value.value.children -%}
  {%- assign group_index = 0 -%}
  {%- assign is_first_heading = true -%}

  <div class="section mlgm-section" id="{{ section.id }}">
    <div class="container">

      {%- if section.settings.above_heading != blank -%}
        <div class="mlgm-above-heading-wrap" {% if settings.animations_enabled != 'disabled' %}data-cc-animate{% endif %}>
          <{{ section.settings.above_heading_tag }} class="mlgm-above-heading">{{ section.settings.above_heading }}</{{ section.settings.above_heading_tag }}>
        </div>
      {%- endif -%}

      {%- for node in rich_nodes -%}

        {%- if node.type == 'heading' -%}
          {%- capture _htext -%}{%- for hc in node.children -%}{{ hc.value }}{%- endfor -%}{%- endcapture -%}
          <div class="mlgm-group-heading-wrap{% unless is_first_heading %} mlgm-group-heading-wrap--next{% endunless %}" {% if settings.animations_enabled != 'disabled' %}data-cc-animate{% endif %}>
            <{{ section.settings.group_heading_tag }}>{{ _htext | strip }}</{{ section.settings.group_heading_tag }}>
          </div>
          {%- assign is_first_heading = false -%}

        {%- elsif node.type == 'list' -%}
          {%- assign group_index = group_index | plus: 1 -%}
          {%- assign g_id = section.id | append: '-g' | append: group_index -%}
          {%- assign group_card_count = 0 -%}
          {%- assign group_grid_items = '' -%}
          {%- assign group_slider_items = '' -%}
          {%- assign group_dot_items = '' -%}

          {%- for item in node.children -%}
            {%- if item.type == 'list-item' -%}
              {%- assign item_name = '' -%}
              {%- assign item_url = '' -%}
              {%- assign item_address = '' -%}
              {%- assign item_rating = '' -%}
              {%- assign _first_text = true -%}

              {%- for child in item.children -%}
                {%- if child.type == 'text' -%}
                  {%- if _first_text -%}
                    {%- assign _first_text = false -%}
                    {%- assign _parts = child.value | split: ' - ' -%}
                    {%- assign item_name = _parts[0] | strip | replace: '&amp;', '&' | replace: '&#39;', "'" | replace: '&#x27;', "'" | replace: '&quot;', '"' -%}
                    {%- assign item_address = _parts[1] | strip | replace: '&amp;', '&' | replace: '&#39;', "'" | replace: '&#x27;', "'" | replace: '&quot;', '"' -%}
                  {%- elsif child.value != blank -%}
                    {%- assign item_rating = child.value | remove_first: ' - ' | strip -%}
                  {%- endif -%}
                {%- elsif child.type == 'link' -%}
                  {%- assign item_url = child.url | default: '' -%}
                {%- endif -%}
              {%- endfor -%}

              {%- if item_name != blank -%}
                {%- assign group_card_count = group_card_count | plus: 1 -%}

                {%- assign _rating_full = 0 -%}
                {%- assign _rating_has_half = false -%}
                {%- if item_rating != blank -%}
                  {%- assign _rating_str = item_rating | split: 'Rating: ' | last | split: '/' | first | strip -%}
                  {%- assign _rating_full = _rating_str | floor -%}
                  {%- if _rating_str contains '.' -%}
                    {%- assign _rating_dec_digit = _rating_str | split: '.' | last | slice: 0 | times: 1 -%}
                    {%- if _rating_dec_digit >= 5 -%}{%- assign _rating_has_half = true -%}{%- endif -%}
                  {%- endif -%}
                {%- endif -%}
                {%- assign _half_pos = _rating_full | plus: 1 -%}

                {%- capture _card -%}
<div class="mlgm-card">
  {%- if _rating_full >= 1 or _rating_has_half -%}
    <div class="mlgm-card__stars">
      {%- for i in (1..5) -%}
        {%- if i <= _rating_full -%}
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 640 640" fill="#108474"><path d="M341.5 45.1C337.4 37.1 329.1 32 320.1 32C311.1 32 302.8 37.1 298.7 45.1L225.1 189.3L65.2 214.7C56.3 216.1 48.9 222.4 46.1 231C43.3 239.6 45.6 249 51.9 255.4L166.3 369.9L141.1 529.8C139.7 538.7 143.4 547.7 150.7 553C158 558.3 167.6 559.1 175.7 555L320.1 481.6L464.4 555C472.4 559.1 482.1 558.3 489.4 553C496.7 547.7 500.4 538.8 499 529.8L473.7 369.9L588.1 255.4C594.5 249 596.7 239.6 593.9 231C591.1 222.4 583.8 216.1 574.8 214.7L415 189.3L341.5 45.1z"/></svg>
        {%- elsif _rating_has_half and i == _half_pos -%}
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 640 640" fill="#108474"><path d="M320.1 417.6C330.1 417.6 340 419.9 349.1 424.6L423.5 462.5L410.5 380C407.3 359.8 414 339.3 428.4 324.8L487.4 265.7L404.9 252.6C384.7 249.4 367.2 236.7 357.9 218.5L319.9 144.1L319.9 417.7zM489.4 553C482.1 558.3 472.4 559.1 464.4 555L320.1 481.6L175.8 555C167.8 559.1 158.1 558.3 150.8 553C143.5 547.7 139.8 538.8 141.2 529.8L166.4 369.9L52 255.4C45.6 249 43.4 239.6 46.2 231C49 222.4 56.3 216.1 65.3 214.7L225.2 189.3L298.8 45.1C302.9 37.1 311.2 32 320.2 32C329.2 32 337.5 37.1 341.6 45.1L415 189.3L574.9 214.7C583.8 216.1 591.2 222.4 594 231C596.8 239.6 594.5 249 588.2 255.4L473.7 369.9L499 529.8C500.4 538.7 496.7 547.7 489.4 553z"/></svg>
        {%- else -%}
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 640 640" fill="#108474"><path d="M320.1 32C329.1 32 337.4 37.1 341.5 45.1L415 189.3L574.9 214.7C583.8 216.1 591.2 222.4 594 231C596.8 239.6 594.5 249 588.2 255.4L473.7 369.9L499 529.8C500.4 538.7 496.7 547.7 489.4 553C482.1 558.3 472.4 559.1 464.4 555L320.1 481.6L175.8 555C167.8 559.1 158.1 558.3 150.8 553C143.5 547.7 139.8 538.8 141.2 529.8L166.4 369.9L52 255.4C45.6 249 43.4 239.6 46.2 231C49 222.4 56.3 216.1 65.3 214.7L225.2 189.3L298.8 45.1C302.9 37.1 311.2 32 320.2 32zM320.1 108.8L262.3 222C258.8 228.8 252.3 233.6 244.7 234.8L119.2 254.8L209 344.7C214.4 350.1 216.9 357.8 215.7 365.4L195.9 490.9L309.2 433.3C316 429.8 324.1 429.8 331 433.3L444.3 490.9L424.5 365.4C423.3 357.8 425.8 350.1 431.2 344.7L521 254.8L395.5 234.8C387.9 233.6 381.4 228.8 377.9 222L320.1 108.8z"/></svg>
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- endif -%}
  {%- if section.settings.card_name_link == 'google_maps' and item_address != blank -%}
    {%- assign _mq = item_name | append: ' ' | append: item_address | url_encode -%}
    <a class="mlgm-card__name mlgm-card__name--link" href="https://www.google.com/maps/search/?api=1&amp;query={{ _mq }}" target="_blank" rel="noopener noreferrer">{{ item_name | escape }}</a>
  {%- elsif section.settings.card_name_link == 'website' and item_url != blank -%}
    <a class="mlgm-card__name mlgm-card__name--link" href="{{ item_url }}" target="_blank" rel="noopener noreferrer">{{ item_name | escape }}</a>
  {%- else -%}
    <span class="mlgm-card__name">{{ item_name | escape }}</span>
  {%- endif -%}
  {%- if item_address != blank -%}<p class="mlgm-card__address">{{ item_address | escape }}</p>{%- endif -%}
</div>
                {%- endcapture -%}

                {%- capture group_grid_items -%}{{ group_grid_items }}{{ _card }}{%- endcapture -%}
                {%- capture group_slider_items -%}{{ group_slider_items }}<li class="slider__item">{{ _card }}</li>{%- endcapture -%}
                {%- capture group_dot_items -%}{{ group_dot_items }}<button class="mlgm-carousel-dot{% if group_card_count == 1 %} active{% endif %}" data-index="{{ group_card_count | minus: 1 }}" aria-label="Slide {{ group_card_count }}"></button>{%- endcapture -%}
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}

          {%- if group_card_count > 0 -%}
            <div class="mlgm-mobile">
              <carousel-slider class="carousel block" inactive id="mlgm-carousel-{{ g_id }}">
                <div class="slider slider--no-scrollbar" id="mlgm-slider-{{ g_id }}">
                  <ul class="slider__grid grid grid-flow-col auto-cols-1 gap-x-theme" role="list">
                    {{- group_slider_items -}}
                  </ul>
                </div>
              </carousel-slider>
              <div class="mlgm-carousel-dots" id="mlgm-dots-{{ g_id }}">
                {{- group_dot_items -}}
              </div>
            </div>

            <div class="mlgm-desktop" {% if settings.animations_enabled != 'disabled' %}data-cc-animate{% endif %}>
              <div class="mlgm-grid mlgm-cols-{{ section.settings.columns }}">
                {{- group_grid_items -}}
              </div>
            </div>

            {%- if group_card_count > 1 -%}
              <script>
                (function () {
                  var slider = document.getElementById('mlgm-slider-{{ g_id }}');
                  var dotsContainer = document.getElementById('mlgm-dots-{{ g_id }}');
                  if (!slider || !dotsContainer) return;
                  var slides = Array.prototype.slice.call(slider.querySelectorAll('.slider__item'));
                  var dots = Array.prototype.slice.call(dotsContainer.querySelectorAll('.mlgm-carousel-dot'));
                  if (!slides.length || !dots.length) return;
                  dots.forEach(function (dot) {
                    dot.addEventListener('click', function () {
                      var slide = slides[parseInt(dot.dataset.index, 10)];
                      if (slide) slide.scrollIntoView({ behavior: 'smooth', inline: 'start', block: 'nearest' });
                    });
                  });
                  if (!('IntersectionObserver' in window)) return;
                  var observer = new IntersectionObserver(function (entries) {
                    entries.forEach(function (entry) {
                      if (entry.isIntersecting && entry.intersectionRatio >= 0.5) {
                        var idx = slides.indexOf(entry.target);
                        dots.forEach(function (d, i) { d.classList.toggle('active', i === idx); });
                      }
                    });
                  }, { root: slider, threshold: 0.5 });
                  slides.forEach(function (s) { observer.observe(s); });
                })();
              </script>
            {%- endif -%}
          {%- endif -%}

        {%- endif -%}
      {%- endfor -%}

    </div>
  </div>

  <style>
    #{{ section.id }}.mlgm-section {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }

    #{{ section.id }} .mlgm-above-heading-wrap {
      text-align: center;
      margin-bottom: 50px;
    }

    #{{ section.id }} .mlgm-above-heading {
      font-family: var(--typography-font-name-Title, "Cormorant Upright");
      font-size: var(--h2-font-size);
      font-style: normal;
      font-weight: 500;
      line-height: 110%;
      letter-spacing: -0.96px;
      color: var(--color-heading, #004275);
      margin: 0;
    }

    #{{ section.id }} .mlgm-group-heading-wrap {
      text-align: center;
      margin-bottom: 32px;
    }

    #{{ section.id }} .mlgm-group-heading-wrap--next {
      margin-top: 56px;
    }

    #{{ section.id }} .mlgm-group-heading-wrap h1,
    #{{ section.id }} .mlgm-group-heading-wrap h2,
    #{{ section.id }} .mlgm-group-heading-wrap h3,
    #{{ section.id }} .mlgm-group-heading-wrap h4,
    #{{ section.id }} .mlgm-group-heading-wrap h5,
    #{{ section.id }} .mlgm-group-heading-wrap h6 {
      font-family: var(--typography-font-name-Title, "Cormorant Upright");
      font-size: var(--h3-font-size);
      font-style: normal;
      font-weight: 500;
      line-height: 110%;
      letter-spacing: -0.96px;
      color: var(--color-heading, #004275);
      margin: 0;
    }

    #{{ section.id }} .mlgm-grid {
      display: flex;
      flex-wrap: wrap;
      gap: 16px;
      justify-content: center;
    }

    #{{ section.id }} .mlgm-cols-2 .mlgm-card { flex: 0 0 calc(50% - 8px); }
    #{{ section.id }} .mlgm-cols-3 .mlgm-card { flex: 0 0 calc(33.333% - 10.667px); }
    #{{ section.id }} .mlgm-cols-4 .mlgm-card { flex: 0 0 calc(25% - 12px); }

    @media (min-width: 768px) and (max-width: 989px) {
      #{{ section.id }} .mlgm-cols-4 .mlgm-card { flex: 0 0 calc(33.333% - 10.667px); }
    }

    #{{ section.id }} .mlgm-card {
      background: var(--color-background-alt, rgba(0,0,0,0.05));
      border-radius: 4px;
      padding: 24px;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      justify-content: space-between;
      gap: 8px;
    }

    #{{ section.id }} .mlgm-card__name {
      font-family: var(--typography-font-name-Paragraph, Roboto);
      font-size: var(--typography-text-size-Text-Medium, 20px);
      font-style: normal;
      font-weight: 500;
      line-height: 150%;
      color: var(--color-heading, #004275);
      margin: 0;
      display: block;
    }

    #{{ section.id }} a.mlgm-card__name--link {
      color: var(--color-link, #1a6c8a);
      text-decoration: underline;
    }

    #{{ section.id }} .mlgm-card__address {
      font-family: var(--typography-font-name-Paragraph, Roboto);
      font-size: var(--typography-text-size-Text-Small, 16px);
      font-style: normal;
      font-weight: 400;
      line-height: 150%;
      color: var(--color-heading, #004275);
      margin: 0;
      white-space: pre-line;
    }

    #{{ section.id }} .mlgm-card__stars {
      display: flex;
      gap: 3px;
      align-items: center;
      justify-content: center;
    }

    #{{ section.id }} .mlgm-mobile { display: block; }
    #{{ section.id }} .mlgm-desktop { display: none; }

    @media (min-width: 768px) {
      #{{ section.id }} .mlgm-mobile { display: none; }
      #{{ section.id }} .mlgm-desktop { display: block; }
    }

    #{{ section.id }} .mlgm-carousel-dots {
      display: flex;
      justify-content: center;
      gap: 8px;
      margin-top: 16px;
    }

    #{{ section.id }} .mlgm-carousel-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: #D8F19C;
      border: none;
      padding: 0;
      cursor: pointer;
      transition: background 0.2s, transform 0.2s;
      flex-shrink: 0;
    }

    #{{ section.id }} .mlgm-carousel-dot.active {
      background: #004275;
    }

    #{{ section.id }} .mlgm-mobile .mlgm-card {
      width: 100%;
    }

    @media (max-width: 767px) {
      #{{ section.id }} .slider .slider__grid {
        width: 100%;
      }
    }
  </style>
{%- endunless -%}

{% schema %}
{
  "name": "MF Location Grid Multi",
  "class": "cc-metafield-location-grid-multi",
  "settings": [
    {
      "type": "paragraph",
      "content": "Reads a rich text metafield structured as alternating headings and unordered lists. Each heading becomes a group title; each list item renders as a card. Expected item format: Name - Address - [Website link] - Rating."
    },
    {
      "type": "text",
      "id": "metafield_namespace",
      "label": "Metafield namespace",
      "info": "e.g. custom",
      "default": "custom"
    },
    {
      "type": "text",
      "id": "metafield_key",
      "label": "Metafield key",
      "info": "e.g. nearby_locations"
    },
    {
      "type": "text",
      "id": "above_heading",
      "label": "Above heading",
      "info": "Optional overall section title displayed above all groups."
    },
    {
      "type": "select",
      "id": "above_heading_tag",
      "label": "Above heading tag",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" }
      ],
      "default": "h2"
    },
    {
      "type": "select",
      "id": "group_heading_tag",
      "label": "Group heading tag",
      "info": "HTML tag for each group title sourced from the metafield headings.",
      "options": [
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" }
      ],
      "default": "h3"
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns",
      "options": [
        { "value": "2", "label": "2 columns" },
        { "value": "3", "label": "3 columns" },
        { "value": "4", "label": "4 columns" }
      ],
      "default": "4"
    },
    {
      "type": "select",
      "id": "card_name_link",
      "label": "Card name link",
      "info": "Link the card name to Google Maps or the website. Only one option applies.",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "google_maps", "label": "Google Maps" },
        { "value": "website", "label": "Website" }
      ],
      "default": "google_maps"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Metafield Location Grid Multi"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer", "aside"]
  }
}
{% endschema %}
